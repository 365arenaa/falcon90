    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Theme Toggle
            const themeToggle = document.getElementById('themeToggle');
            const body = document.body;
            
            themeToggle.addEventListener('click', function() {
                body.classList.toggle('dark-mode');
                themeToggle.classList.toggle('dark');
                localStorage.setItem('theme', body.classList.contains('dark-mode') ? 'dark' : 'light');
            });
            
            // Load saved theme
            const savedTheme = localStorage.getItem('theme');
            if (savedTheme === 'dark') {
                body.classList.add('dark-mode');
                themeToggle.classList.add('dark');
            }
            
            // Mobile Menu
            const mobileMenuButton = document.getElementById('mobileMenuButton');
            const mobileNav = document.getElementById('mobileNav');
            const overlay = document.getElementById('overlay');
            const closeMobileNav = document.getElementById('closeMobileNav');
            
            mobileMenuButton.addEventListener('click', function() {
                mobileNav.classList.add('open');
                overlay.style.display = 'block';
            });
            
            closeMobileNav.addEventListener('click', function() {
                mobileNav.classList.remove('open');
                overlay.style.display = 'none';
            });
            
            overlay.addEventListener('click', function() {
                mobileNav.classList.remove('open');
                overlay.style.display = 'none';
            });
            
            // AI Assistant
            const aiButton = document.getElementById('aiButton');
            const aiChat = document.getElementById('aiChat');
            const aiCloseButton = document.getElementById('aiCloseButton');
            const aiSendButton = document.getElementById('aiSendButton');
            const aiInput = document.querySelector('.ai-input');
            const aiMessages = document.getElementById('aiMessages');
            
            aiButton.addEventListener('click', function() {
                aiChat.style.display = aiChat.style.display === 'block' ? 'none' : 'block';
            });
            
            aiCloseButton.addEventListener('click', function() {
                aiChat.style.display = 'none';
            });
            
            aiSendButton.addEventListener('click', sendMessage);
            aiInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    sendMessage();
                }
            });
            
            function sendMessage() {
                const message = aiInput.value.trim();
                if (message) {
                    // Add user message
                    addMessage(message, 'user');
                    aiInput.value = '';
                    
                    // Simulate AI response
                    setTimeout(() => {
                        const response = generateAIResponse(message);
                        addMessage(response, 'bot');
                    }, 1000);
                }
            }
            
            function addMessage(text, sender) {
                const messageDiv = document.createElement('div');
                messageDiv.className = `ai-message ai-message-${sender}`;
                
                const contentDiv = document.createElement('div');
                contentDiv.className = 'ai-message-content';
                contentDiv.textContent = text;
                
                messageDiv.appendChild(contentDiv);
                aiMessages.appendChild(messageDiv);
                
                // Scroll to bottom
                aiMessages.scrollTop = aiMessages.scrollHeight;
            }
            
            function generateAIResponse(message) {
                const lowerMessage = message.toLowerCase();
                
                if (lowerMessage.includes('مباراة') || lowerMessage.includes('نتيجة')) {
                    return 'فاز النادي الأهلي على النادي الاتحاد بنتيجة 2-1 في المباراة التي جمعتهما مساء اليوم.';
                } else if (lowerMessage.includes('هداف') || lowerMessage.includes('هدافين')) {
                    return 'حاليا، كريستيانو رونالدو هو هداف الدوري برصيد 12 هدفاً، يليه ساديو ماني برصيد 10 أهداف.';
                } else if (lowerMessage.includes('اليمن') || lowerMessage.includes('منتخب')) {
                    return 'المنتخب اليمني سيخوض مباراة مهمة ضد المنتخب السعودي يوم 15 نوفمبر في إطار تصفيات كأس العالم.';
                } else if (lowerMessage.includes('دوري') || lowerMessage.includes('بطولة')) {
                    return 'الدوري الإنجليزي هو الأكثر متابعة في العالم، يليه الدوري الإسباني ثم الدوري الإيطالي.';
                } else {
                    return 'شكراً لاستفسارك! كيف يمكنني مساعدتك في مجال الرياضة والأخبار الرياضية؟';
                }
            }
            
            // Language Selector
            const languageSelector = document.getElementById('languageSelector');
            
            languageSelector.addEventListener('change', function() {
                const selectedLang = this.value;
                // In a real application, you would change the language here
                alert(`تم تغيير اللغة إلى ${this.options[this.selectedIndex].text}`);
                localStorage.setItem('language', selectedLang);
            });
            
            // Load saved language
            const savedLanguage = localStorage.getItem('language');
            if (savedLanguage) {
                languageSelector.value = savedLanguage;
            }
            
            // Simulate live score updates
            setInterval(() => {
                const liveMatches = document.querySelectorAll('.match-status.status-live');
                liveMatches.forEach(match => {
                    const scoreElement = match.closest('.match-card').querySelector('.match-score');
                    if (scoreElement && Math.random() > 0.7) {
                        const score = scoreElement.textContent.split(' - ');
                        const teamToUpdate = Math.floor(Math.random() * 2);
                        score[teamToUpdate] = parseInt(score[teamToUpdate]) + 1;
                        scoreElement.textContent = score.join(' - ');
                        
                        // Add animation
                        scoreElement.classList.add('fade-in');
                        setTimeout(() => {
                            scoreElement.classList.remove('fade-in');
                        }, 1000);
                    }
                });
            }, 10000);
        });
    </script>
