                </nav>
                <div class="search-container">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" class="search-input" placeholder="ابحث عن فريق أو لاعب...">
                </div>
                <button class="mobile-menu-button" id="mobileMenuButton">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
        </div>
        <div class="news-ticker">
            <div class="ticker-content">
                <div class="ticker-item">
                    <span class="live-dot"></span>
                    <span>المنتخب اليمني يتأهل إلى الجولة التالية من التصفيات الآسيوية</span>
                </div>
                <div class="ticker-item">
                    <span class="live-dot"></span>
                    <span>ليفربول يتغلب على مانشستر سيتي بثلاثية نظيفة</span>
                </div>
                <div class="ticker-item">
                    <span class="live-dot"></span>
                    <span>انطلاق دوري أبطال أوروبا الأسبوع المقبل</span>
                </div>
            </div>
        </div>
    </header>

    <!-- Mobile Navigation -->
    <div class="mobile-nav" id="mobileNav">
        <div class="mobile-nav-header">
            <div class="logo">
                <div class="logo-icon">🏆</div>
                <div class="logo-text">FALCON90</div>
            </div>
            <button class="ai-close-button" id="closeMobileNav">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <ul class="mobile-nav-links">
            <li><a href="#">الرئيسية</a></li>
            <li><a href="#">مباريات اليوم</a></li>
            <li><a href="#">الدوريات</a></li>
            <li><a href="#">المنتخب اليمني</a></li>
            <li><a href="#">الأخبار</a></li>
            <li><a href="#">التوقعات</a></li>
            <li><a href="#">إعدادات</a></li>
            <li><a href="#">تسجيل الدخول</a></li>
        </ul>
    </div>
    <div class="overlay" id="overlay"></div>

    <!-- Main Content -->
    <main class="main-content">
        <div class="container">
